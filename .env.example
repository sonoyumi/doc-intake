# Copy to .env and fill in. The .env file never goes to git.

# Random string, 32+ characters: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Panel address. Behind HTTPS (nginx/Caddy) set COOKIE_SECURE=true.
HOST=127.0.0.1
PORT=8097
COOKIE_SECURE=false
COMPANY_NAME=Studio Rossi · Documents

# Where the database, the uploaded files and the inbox folder live.
DATA_DIR=data

# off    = PDFs with a text layer are read by patterns, scans and photos are entered by hand (free)
# claude = Claude reads every document, including scans and phone photos (needs ANTHROPIC_API_KEY)
AI_MODE=off
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Hard cap on documents sent to the AI per day (protects the bill)
AI_DAILY_LIMIT=200

# Upload limits
MAX_FILE_MB=15
MAX_PAGES=10
